# systemd-юнит для запуска без Docker.
#
#   sudo cp deploy/chtostuchit.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now chtostuchit
#
# Привязка строго к 127.0.0.1. Раньше uvicorn слушал публичный IP на 8080, то
# есть приложение торчало в интернет по HTTP мимо nginx: без TLS микрофон там
# всё равно не работает, а нагрузку и злоупотребления оно принимало. Снаружи с
# сервисом должен говорить только nginx.

[Unit]
Description=Что стучит — диагностика автомобиля по звуку
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/var/www/chtostuchit
EnvironmentFile=/var/www/chtostuchit/.env

# Порт должен совпадать с proxy_pass в deploy/nginx.conf.
ExecStart=/var/www/chtostuchit/.venv/bin/uvicorn service.app:app \
    --host 127.0.0.1 --port 8090 \
    --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1

# Модель занимает около 700 МБ и грузится с прогревом CLAP почти 10 секунд:
# меньше давать нельзя, иначе systemd убьёт процесс на старте.
TimeoutStartSec=180
Restart=always
RestartSec=5

# Один воркер держит модель в памяти. Масштабироваться репликами, а не
# воркерами: иначе память умножится на их число.

User=www-data
Group=www-data
# Корпус пишется сюда, каталог должен принадлежать www-data.
ReadWritePaths=/var/www/chtostuchit

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
