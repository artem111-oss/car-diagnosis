# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Разбор механиком (AIMLAPI) ---------------------------------------
# Без ключа сервис работает, но выдаёт только акустический результат.
AIMLAPI_KEY=

# Выбрана замером на подтверждённом случае: валидный JSON, верно объясняет
# связь симптома с механикой, честно обозначает пределы вывода.
AIMLAPI_MODEL=anthropic/claude-haiku-latest
# Вчетверо дешевле при сопоставимом качестве:
# AIMLAPI_MODEL=alibaba/qwen3.7-plus

AIMLAPI_TIMEOUT=60
AIMLAPI_MAX_TOKENS=1600

# --- Ограничения -------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_CLIP_SECONDS=60
RATE_LIMIT_PER_HOUR=20

# --- Хранилище ---------------------------------------------------------
# В проде смонтируйте том или переведите на S3.
CORPUS_DIR=/data/corpus

# --- Прочее ------------------------------------------------------------
LOG_LEVEL=INFO
# Пусто = документация API закрыта. Для отладки: DOCS_URL=/docs
DOCS_URL=
# Через запятую, если фронт живёт на другом домене.
ALLOWED_ORIGINS=

# Модель CLAP качается с HuggingFace при первом запуске (~2 ГБ).
# В образе она уже прогрета, менять не нужно.
HF_HOME=/models/hf
