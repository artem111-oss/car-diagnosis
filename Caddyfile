# Два домена, один канонический.
#
# chtostuchit.ru выбран основным не из вкуса, а из-за punycode: кириллический
# адрес в мессенджерах, почтовых клиентах и старом софте нередко ломается при
# копировании, а латиница работает везде. Кириллический домен остаётся живым и
# ведёт на основной — так он приводит людей, но не плодит дубли для поиска.
#
# чтостучит.рф в конфигах и сертификатах существует только как punycode:
# xn--h1aljccbf1af.xn--p1ai

# --- Кириллический домен и www: постоянный редирект на канонический ---------
xn--h1aljccbf1af.xn--p1ai, www.xn--h1aljccbf1af.xn--p1ai, www.chtostuchit.ru {
	redir https://chtostuchit.ru{uri} permanent
}

# --- Канонический домен -----------------------------------------------------
chtostuchit.ru {
	encode gzip zstd

	# Загрузка аудио: держим запас над MAX_UPLOAD_MB сервиса.
	request_body {
		max_size 30MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Микрофон нужен нам, всё остальное запрещаем.
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}

	reverse_proxy app:8080 {
		# Анализ занимает секунды, разбор механиком — до минуты.
		transport http {
			read_timeout 120s
		}
	}
}
